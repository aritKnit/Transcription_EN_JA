# Copy to .env and adjust per deployment. Laptop and server run the same images.

# Speech engine: which model runs. Everything else (gateway, bench, web app) is the same for any of them.
BACKEND=sensevoice                 # sensevoice (FunAudioLLM/SenseVoiceSmall) or faster_whisper (any CTranslate2 Whisper model)
MODEL_DIR=sensevoice-small-v1      # folder under models/; roll back by pointing at the previous one

MAX_CLIENTS=1              # seats; raise to 2 only after the two-stream test passes
MAX_CONNECTION_TIME=3600   # seconds a session may last
ENGINE_THREADS=4           # CPU threads for the model
ENGINE_CPUS=4              # container CPU cap
ENGINE_MEM=3g              # container memory cap (SenseVoice needs about 2 GB; faster_whisper base about 1 GB)
