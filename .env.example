# Copy to .env and adjust per deployment. Laptop and server run the same images.

# Speech engine
MODEL_DIR=base-v1          # folder under models/; roll back by pointing at the previous one
MAX_CLIENTS=1              # seats; raise to 2 only after the two-stream test passes
MAX_CONNECTION_TIME=3600   # seconds a session may last
ENGINE_THREADS=4           # OpenMP threads for the model
ENGINE_CPUS=4              # container CPU cap
ENGINE_MEM=2g              # container memory cap
